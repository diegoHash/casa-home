# Local development defaults already target http://localhost:8787 and ws://localhost:8787/ws.
# Production defaults use same-origin Nginx routes /conference-api and /conference-ws.
VITE_CONFERENCE_BACKEND_URL=
VITE_CONFERENCE_SIGNALING_URL=

# Production uses the CASA SFU by default. Set false only for rollback.
VITE_CONFERENCE_SFU_ENABLED=true
